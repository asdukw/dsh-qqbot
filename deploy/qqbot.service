[Unit]
Description=QQ chat bot (NapCat + DSH)
After=network-online.target docker.service
Wants=network-online.target
OnFailure=qqbot-alert.service
# Tolerate restart storms (apt unattended-upgrades + needrestart).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=qqbot
Group=qqbot
WorkingDirectory=/opt/qqbot/bot
EnvironmentFile=/etc/qqbot/bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/qqbot
ExecStart=/opt/qqbot/bot/venv/bin/python /opt/qqbot/bot/main.py --config /etc/qqbot/config.toml
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/qqbot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qqbot

[Install]
WantedBy=multi-user.target
